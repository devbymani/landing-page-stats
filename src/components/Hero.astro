---
// Astro Image
import { Image } from "astro:assets";

// Images
import IllustrationHeroImage from '../assets/IllustrationHeroImage.svg';
---

<section data-route="/" id="route-home" class="relative font-secondary section-spacing !mt-0">
  <div class="grid grid-cols-2 gap-2 hero-content container">
    <div class="flex items-center flex-col justify-center content text-center space-y-4">
      <h1 class="text-3xl md:text-4xl font-semibold">Store, Share & Manage Your Files — Securely, Anywhere</h1>
      <p>Keep your team's files organized, protected, and accessible from anywhere. Collaborate securely without the complexity of traditional file storage.</p>
      <div class="flex items-center justify-center gap-2">
        <button
          type="button"
          class="relative bg-linear-to-br from-bprimary to-bsecondary text-white px-4 py-2 rounded-full cursor-pointer"
          onclick="window.location.href='/features'">
          Get Started
        </button>
        <button
          type="button"
          class="relative bg-slate-100 px-4 py-2 rounded-full cursor-pointer"
          onclick="window.location.href='/'">
          How It Works!
        </button>
      </div>
    </div>
    <div class="img flex items-center justify-center relative">
      <Image src={IllustrationHeroImage} alt="Hero Image" class="w-96 h-96" />
    </div>
  </div>
</section>

<style is:global>
  .hero-bg {
    background: hsl(217, 28%, 15%) url(../assets/IllustrationHeroImageWave.svg) no-repeat bottom center contain;
    width: 100%;
    height: 100%;
    position: absolute;
    bottom: 14rem;
    z-index: -1;

  }
  @media (min-width: 768px) {
    .hero-bg {
      background: hsl(217, 28%, 15%) url(../assets/IllustrationHeroImageWave.svg) no-repeat bottom center 100% 280px;
      width: 100%;
      height: 100%;
      position: absolute;
      bottom: 0;
      z-index: 0;
    }
  }
</style>