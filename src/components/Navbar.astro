---
const navItems = [
  { name: "Features", href: "/features" },
  { name: "Pricing", href: "/pricing" },
  {
    name: "Resources",
    href: "/productive",
    children: [
      { name: "Business", href: "/" },
      { name: "Students", href: "/" }
    ]
  },
];

const authItems = [
  { name: "Login", href: "/login" },
  { name: "Get Started", href: "/register" },
];
---

<nav class="flex items-center justify-between w-full">
  <div class="hidden md:flex items-center justify-center w-full">
    <ul class="flex items-center justify-center gap-10 flex-1">
      {navItems.map((item) => {
        const hasDropdown = item.children?.length;
  
        return (
          <li class="relative" data-nav-item>
            {hasDropdown ? (
              <>
                <button
                  type="button"
                  class="nav-dropdown-btn inline-flex items-center gap-2 transition-colors duration-200 hover:text-slate-400"
                  aria-haspopup="menu"
                  aria-expanded="false">
                  <span>{item.name}</span>
                  <i class="ri-arrow-down-s-line nav-dropdown-arrow"></i>
                </button>
                {/* Dropdown Menu */}
                <ul class="nav-dropdown-menu absolute left-0 mt-2 w-48 bg-white border border-gray-100 shadow-lg rounded-md py-2 z-50"
                  role="menu"
                  aria-label={`${item.name} menu`}>
                  {(item.children ?? []).map((c) => (
                    <li>
                      <a href={c.href} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        {c.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href} class="transition-colors duration-300 hover:text-slate-400">
                {item.name}
              </a>
            )}
          </li>
        );
      })}
    </ul>

    <ul class="flex items-center justify-end gap-3">
      {authItems.map((item) => (
        <li>
          <a href={item.href} class={item.name === "Login" ? "bg-slate-100 transition-colors duration-300 px-4 py-2 border border-slate-200 rounded-lg" : "inline-flex items-center justify-center flex-none gap-4 bg-linear-to-br from-bprimary to-bsecondary text-white border-0 outline-0 px-4 py-2 rounded-lg relative overflow-hidden hover:bg-bsecondary/80 whitespace-nowrap"}>
            {item.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <!-- Mobile Hamburger Menu -->
  <button
    class="md:hidden inline-flex items-center justify-center p-2 rounded-lg hover:bg-gray-100 transition"
    type="button"
    id="mobileMenuBtn"
    aria-label="Open menu"
    aria-expanded="false"
  >
    <i class="ri-menu-line text-2xl leading-none"></i>
  </button>
</nav>

<script>
  (() => {
    const dropdownItems = document.querySelectorAll('[data-nav-item]');
    const dropdownBtns = document.querySelectorAll('.nav-dropdown-btn');

    function closeAll() {
      dropdownItems.forEach((li) => {
        li.classList.remove('nav-open');
        const arrow = li.querySelector('.nav-dropdown-arrow');
        if (arrow) arrow.classList.remove('rotate-180');
      });
    }

    dropdownBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const li = btn.closest('[data-nav-item]');
        if (!li) return;

        const arrow = li.querySelector('.nav-dropdown-arrow');

        const isOpen = li.classList.contains('nav-open');

        closeAll();
        if (!isOpen) {
          li.classList.add('nav-open');
          if (arrow) arrow.classList.add('rotate-180');
        }
      });
    });

    document.addEventListener('click', () => closeAll());
  })();
</script>