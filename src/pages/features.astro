---
import MainLayout from "../layout/MainLayout.astro";
---

<MainLayout>
  <section class="my-10 pt-20">
    <div class="container mx-auto">
      <!-- Unlock Perks -->
      <div class="flex items-center justify-center gap-10 flex-col max-w-2xl mx-auto text-center">
        <h1 class="text-7xl font-black">Get 30% off & Unlock Perks!</h1>
        <p class="text-xl">Fyck has partnered with leading brands to bring you exclusive deals and early access to new features with your subscription.</p>
        <p class="text-md text-gray-400 font-bold">Sign up now to claim your exclusive perks!</p>
        <button type="button" class="bg-linear-to-br from-bprimary to-bsecondary text-white py-2 px-4 rounded-lg hover:bg-bsecondary/80">Sign up now</button>
      </div>
      <!-- Features -->
      <!-- FAQ -->
    </div>
  </section>
</MainLayout>